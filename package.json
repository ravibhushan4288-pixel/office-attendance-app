{
  "name": "office-attendance-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": "server/server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:admin": "npm run build && npx pkg . --targets node18-win-x64 --output attendance-admin.exe",
    "build:client": "npx pkg client/package.json --targets node18-win-x64 --output attendance-client.exe",
    "build:all": "node build-binaries.cjs"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "server/db.js"
    ]
  },
  "dependencies": {
    "lucide-react": "^0.470.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "rcedit": "^5.0.2",
    "vite": "^5.3.1"
  }
}
